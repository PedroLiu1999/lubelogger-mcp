# ==============================================================================
# lubelogger-mcp Environment Configuration
# Copy this file to .env and fill in your credentials before running Docker.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Public Endpoint Configuration
# ------------------------------------------------------------------------------

# Public HTTPS base URL exposed via Cloudflare Tunnel or reverse proxy (no trailing slash).
# Your MCP endpoint will be reachable at ${PUBLIC_URL}/mcp.
PUBLIC_URL=https://lubelogger-mcp.example.com

# HTTP port the container listens on (bound to 127.0.0.1:${PORT}:3000 on host).
PORT=3000

# Container image tag for lubelogger-mcp (default: latest).
LUBELOGGER_MCP_VERSION=latest

# Persistent data directory inside the container.
# Stores the Token Store (/data/oauth-tokens.json).
DATA_DIR=/data

# ------------------------------------------------------------------------------
# 2. Embedded OAuth 2.1 Server (Public Client + PKCE)
# ------------------------------------------------------------------------------

# Admin passphrase prompted on the HTML consent screen (GET /authorize) when
# approving an AI client's connection for the first time.
OAUTH_ADMIN_PASSWORD=replace-with-a-strong-admin-consent-passphrase

# Comma-separated list of allowed OAuth redirect URIs.
# Loopback hosts (http://localhost and http://127.0.0.1) match any ephemeral port per RFC 8252.
# Trailing slashes match subpath prefixes (e.g. for Google Gemini dynamic project callbacks).
OAUTH_ALLOWED_REDIRECT_URIS=http://localhost,http://127.0.0.1,https://oauth-redirect.googleusercontent.com/r/,https://oauth-redirect.googleusercontent.com/a/,https://oauth-redirect-sandbox.googleusercontent.com/r/,https://oauth-redirect-sandbox.googleusercontent.com/a/,https://oauth-redirect-test.googleusercontent.com/r/,https://oauth-redirect-test.googleusercontent.com/a/,https://vertexaisearch.cloud.google.com/oauth-redirect

# ------------------------------------------------------------------------------
# 3. LubeLogger Connection & Authentication
# ------------------------------------------------------------------------------

# URL of your self-hosted LubeLogger instance.
# When LubeLogger is bound to the VPS host or publishing a host port,
# use host.docker.internal (mapped via extra_hosts in docker-compose.yml).
LUBELOGGER_URL=http://host.docker.internal:8383

# Option A: API Key authentication (Recommended).
# Generate an API key in LubeLogger under Settings -> API Keys (Manager or Editor scope).
LUBELOGGER_API_KEY=replace-with-your-lubelogger-api-key

# Option B: Basic Auth credentials (alternative if not using API keys).
# LUBELOGGER_USERNAME=
# LUBELOGGER_PASSWORD=

# Optional: In-memory vehicle cache TTL in seconds (default: 30).
CACHE_TTL_SECONDS=30
