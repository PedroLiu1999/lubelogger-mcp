{
  "name": "lubelogger-mcp",
  "version": "1.2.1",
  "description": "Self-contained MCP server for LubeLogger over Streamable HTTP and OAuth 2.1",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
